# ================================================
#  Click Suporte — .htaccess (Static Site)
#  Corrige sitemap, bloqueia WordPress, segurança
# ================================================

Options -Indexes

# ─── MIME TYPES CORRETOS ───────────────────────
<IfModule mod_mime.c>
  AddType application/xml        .xml
  AddType text/css               .css
  AddType application/javascript .js
  AddType image/svg+xml          .svg
  AddType image/webp             .webp
  AddType application/manifest+json .json
</IfModule>

# ─── FORÇAR XML NO SITEMAP ─────────────────────
<Files "sitemap.xml">
  ForceType application/xml
  Header set Content-Type "application/xml; charset=UTF-8"
</Files>

# ─── REWRITE: BLOQUEIA WORDPRESS ───────────────
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Se o arquivo existir fisicamente, serve direto (não redireciona)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Bloqueia chamadas do WordPress que possam ter sobrado
RewriteRule ^wp-login\.php - [F,L]
RewriteRule ^wp-admin/.*  - [F,L]
RewriteRule ^wp-content/.* - [F,L]
RewriteRule ^wp-includes/.* - [F,L]
</IfModule>

# ─── SEGURANÇA ─────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── CACHE (PERFORMANCE) ───────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png              "access plus 6 months"
  ExpiresByType image/jpeg             "access plus 6 months"
  ExpiresByType image/svg+xml          "access plus 6 months"
  ExpiresByType application/xml        "access plus 1 day"
</IfModule>

# ─── GZIP (COMPRESSÃO) ─────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml
</IfModule>

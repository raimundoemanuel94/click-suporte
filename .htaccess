# Limpeza de Redirecionamentos - Click Suporte Static
# Remove todas as regras do antigo WordPress

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Se o arquivo existir fisicamente, não redirecione nada
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Opcional: Redirecionar tudo para o index.html se não encontrar (Mantenha desativado para depurar)
# RewriteRule . /index.html [L]
</IfModule>
